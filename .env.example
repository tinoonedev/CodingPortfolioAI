# Local PostgreSQL via Docker Compose. Keep the password in the ignored .env file.
POSTGRES_DB=fieldwork
POSTGRES_USER=fieldwork
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://fieldwork:replace-with-a-long-random-password@127.0.0.1:5433/fieldwork
# Optional separate schema-owner connection; prefer this for production migrations.
# MIGRATION_DATABASE_URL=postgresql://fieldwork_migrator:replace-me@127.0.0.1:5433/fieldwork
DATABASE_SSL=false

# Local email/password accounts use invitation tokens stored as hashes in PostgreSQL.
APP_ORIGIN=http://127.0.0.1:4173
STUDIO_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
STUDIO_WORKSPACE_NAME=Fieldwork Studio

API_PORT=3001
TRUST_PROXY_HOPS=0

# Optional Fieldwork platform-owned Atlassian OAuth 2.0 (3LO) connection.
# Register this exact callback URL in the Atlassian developer console.
# Keep the client secret and keyring only in the server environment/secret manager.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/integrations/jira/callback
# JSON: {"activeKeyId":"local-v1","keys":{"local-v1":"<base64-encoded-32-byte-key>"}}
# Generate each key with: openssl rand -base64 32
JIRA_TOKEN_ENCRYPTION_KEYRING=

# OpenAI API keys are entered per client project and encrypted in PostgreSQL.
# Keep this server-side keyring outside source control; generate its key using:
# openssl rand -base64 32
# OPENAI_TOKEN_ENCRYPTION_KEYRING={"activeKeyId":"local-v1","keys":{"local-v1":"<base64-encoded-32-byte-key>"}}
# Configure a reviewed model allowlist with current USD per 1M input/output token rates from:
# https://developers.openai.com/api/docs/pricing
# Example shape: {"<approved-model-id>":{"input":<usd-per-million> ,"output":<usd-per-million>}}
# Leave unset until the selected model's current rates have been verified.

# Local PostgreSQL via Docker Compose. Keep the password in the ignored .env file.
POSTGRES_DB=fieldwork
POSTGRES_USER=fieldwork
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://fieldwork:replace-with-a-long-random-password@127.0.0.1:5433/fieldwork
# Optional separate schema-owner connection; prefer this for production migrations.
# MIGRATION_DATABASE_URL=postgresql://fieldwork_migrator:replace-me@127.0.0.1:5433/fieldwork
DATABASE_SSL=false

# Local email/password accounts use invitation tokens stored as hashes in PostgreSQL.
APP_ORIGIN=http://127.0.0.1:4173
STUDIO_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
STUDIO_WORKSPACE_NAME=Fieldwork Studio

API_PORT=3001
TRUST_PROXY_HOPS=0
